"""## 7.2 Risk-Based Capital Allocation

* **Bài toán kinh doanh:** Với một nguồn vốn hữu hạn X, làm thế nào để phân bổ danh mục vào các nhóm khách hàng (`sub-grade`) nhằm đạt lợi nhuận cao nhất mà vẫn kiểm soát được tổn thất tối đa trong ngưỡng cho phép?

* **Cơ chế thực hiện:**
Mỗi nhóm khách hàng được đặc trưng bởi Lợi nhuận kỳ vọng (E[Profit]) và Giá trị rủi ro (VaR) khác nhau.
Từ đó cần tìm tỷ trọng phân bổ vốn sao cho tổng lợi nhuận là lớn nhất, với điều kiện tổng mức rủi ro (Portfolio VaR) không vượt quá Khẩu vị rủi ro (Risk Appetite) của tổ chức.

* **Kỳ vọng phân tích:** Mô hình sẽ chỉ ra rằng không nên dồn toàn bộ vốn vào nhóm có lãi suất cao nhất (thường là nhóm rủi ro cao).
Phân bổ tối ưu thường là một danh mục đa dạng, kết hợp giữa các nhóm an toàn để bảo vệ vốn và các nhóm lợi nhuận cao để tối ưu hiệu suất, giúp đạt được Tỷ suất lợi nhuận trên vốn điều chỉnh theo rủi ro (RAROC) tốt nhất.
"""

print("\n" + "=" * 60)
print("KỊCH BẢN 4 — CAPITAL ALLOCATION THEO RISK/RETURN")
print("=" * 60)

# Tính Risk/Return profile cho từng sub_grade
result_df_kb3['sub_grade'] = df_final.loc[X_test.index, 'sub_grade'].values
result_df_kb3['grade']     = result_df_kb3['sub_grade'].str[0]

# Tổng hợp theo sub_grade
subgrade_profile = result_df_kb3.groupby('sub_grade').agg(
    n_loans     = ('loan_amnt', 'count'),
    avg_loan    = ('loan_amnt', 'mean'),
    avg_PD      = ('PD', 'mean'),
    avg_profit  = ('E_profit', 'mean'),
    total_profit= ('E_profit', 'sum'),
    total_loan  = ('loan_amnt', 'sum'),
).reset_index()

subgrade_profile['grade']        = subgrade_profile['sub_grade'].str[0]
subgrade_profile['profit_ratio'] = subgrade_profile['avg_profit'] / subgrade_profile['avg_loan']  # Return per $ lent
subgrade_profile = subgrade_profile[subgrade_profile['n_loans'] >= 20]  # Lọc sub_grade đủ data

print("\nRisk/Return Profile theo Sub_Grade:")
print(subgrade_profile[['sub_grade', 'n_loans', 'avg_PD', 'avg_profit',
                          'profit_ratio']].to_string(index=False))

# Budget = tổng loan_amnt hiện tại nên phân bổ vào sub_grade nào
TOTAL_BUDGET = result_df_kb3['loan_amnt'].sum()   # Tổng ngân sách
MAX_PD_ALLOW = 0.35                                # Giới hạn PD tối đa chấp nhận
MIN_LOANS    = 20                                  # Tối thiểu 20 khoản/nhóm

# Chỉ xét sub_grade có avg_PD <= MAX_PD_ALLOW và E_profit > 0
eligible = subgrade_profile[
    (subgrade_profile['avg_PD'] <= MAX_PD_ALLOW) &
    (subgrade_profile['avg_profit'] > 0)
].copy()

eligible = eligible.sort_values('profit_ratio', ascending=False)

# Ưu tiên sub_grade có profit_ratio cao nhất
# Phân bổ theo tỷ lệ profit_ratio
eligible['weight']         = eligible['profit_ratio'] / eligible['profit_ratio'].sum()
eligible['allocated_budget']= eligible['weight'] * TOTAL_BUDGET
eligible['n_loans_target'] = (eligible['allocated_budget'] / eligible['avg_loan']).astype(int)
eligible['expected_total_profit'] = eligible['n_loans_target'] * eligible['avg_profit']

print(f"\n=== KẾT QUẢ KB4 — PHÂN BỔ VỐN TỐI ƯU ===")
print(f"Tổng ngân sách        : ${TOTAL_BUDGET:,.0f}")
print(f"Giới hạn PD tối đa    : {MAX_PD_ALLOW:.0%}")
print(f"Số sub_grade đủ điều kiện: {len(eligible)}")
print(f"\nPhân bổ tối ưu:")
print(eligible[['sub_grade', 'avg_PD', 'profit_ratio', 'weight',
                 'allocated_budget', 'n_loans_target',
                 'expected_total_profit']].to_string(index=False))
print(f"\nTổng E[Profit] kỳ vọng: ${eligible['expected_total_profit'].sum():,.0f}")

# Trực quan hoá
grade_colors = {'A':'#2ecc71','B':'#27ae60','C':'#f39c12',
