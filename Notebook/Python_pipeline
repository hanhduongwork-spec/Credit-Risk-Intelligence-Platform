X_train_inner, X_val_inner, y_train_inner, y_val_inner = train_test_split(
    X_tune, y_tune, test_size=0.2, stratify=y_tune, random_state=100
)

def objective(trial):
    param = {
        'objective': 'binary',
        'metric': 'auc',
        'verbosity': -1,
        'boosting_type': 'gbdt',
        'random_state': 100,
        'n_jobs': -1,
        'learning_rate': trial.suggest_float('learning_rate', 0.005, 0.05),
        'n_estimators': 1000,

        'scale_pos_weight': trial.suggest_float('scale_pos_weight', 1.0, 5.0),
        'num_leaves': trial.suggest_int('num_leaves', 15, 63),
        'max_depth': trial.suggest_int('max_depth', 3, 12),
        'min_child_samples': trial.suggest_int('min_child_samples', 200, 2000),
        'feature_fraction': trial.suggest_float('feature_fraction', 0.4, 0.8),
        'lambda_l1': trial.suggest_float('lambda_l1', 1e-3, 10.0, log=True),
        'lambda_l2': trial.suggest_float('lambda_l2', 1e-3, 10.0, log=True),
    }

    model = LGBMClassifier(**param)

    model.fit(
        X_train_inner, y_train_inner,
        eval_set=[(X_val_inner, y_val_inner)],
        callbacks=[early_stopping(stopping_rounds=50), log_evaluation(0)]
    )

    y_probs = model.predict_proba(X_val_inner)[:, 1]
    auc = roc_auc_score(y_val_inner, y_probs)
    return auc

# 2. Chạy Optuna
study = optuna.create_study(direction='maximize')
study.optimize(objective, n_trials=20)

print(f"\nAUC tốt nhất trên tập Val: {study.best_value:.4f}")

# 3. Re-train final model với full features
final_params = study.best_params.copy()
final_model = LGBMClassifier(**final_params, n_estimators=400, random_state=100)
final_model.fit(X_train, y_train)

