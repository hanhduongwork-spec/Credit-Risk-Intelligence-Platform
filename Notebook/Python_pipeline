"""# 7. OPTIMIZATION

## 7.1 Portfolio Optimization (Approval Policy)
* **Bài toán kinh doanh:** Xác định ngưỡng xác suất vỡ nợ (PD Threshold) tối ưu để sàng lọc các khoản vay, nhằm tối đa hóa tổng lợi nhuận cho toàn danh mục.

* **Cơ chế thực hiện:** Thực hiện mô phỏng trên một dải các ngưỡng cắt (PD Thresholds).
Tại mỗi ngưỡng, hệ thống sẽ lọc ra các khoản vay thỏa mãn điều kiện phê duyệt, sau đó tính toán Tổng lợi nhuận kỳ vọng của toàn bộ danh mục tương ứng. Từ đó, ngưỡng cắt mang lại tổng lợi nhuận cao nhất chính là Ngưỡng phê duyệt tối ưu.
* **Kỳ vọng phân tích:**
* Ngưỡng quá thấp: Chính sách quá khắt khe dẫn đến tỷ lệ từ chối cao, làm mất cơ hội doanh thu từ những khách hàng tốt.

* Ngưỡng quá cao: Chính sách quá lỏng lẻo khiến danh mục chịu gánh nặng từ các khoản nợ xấu, dẫn đến sụt giảm lợi nhuận thực tế.

* Điểm tối ưu: Là điểm cân bằng giúp tối đa hóa quy mô danh mục trong khi vẫn kiểm soát được chi phí rủi ro ở mức cho phép.
"""

# Quét PD threshold → tối đa tổng E[Profit]

result_df_kb3 = X_test.copy()
result_df_kb3['PD'] = pd_scores

# Tính E_profit cho từng khoản vay
loan_amounts_kb3  = result_df_kb3['loan_amnt'].values
int_rates_kb3     = result_df_kb3['int_rate'].values
term_monthses_kb3 = result_df_kb3['term_months'].values.astype(int)
PD_values_kb3     = result_df_kb3['PD'].values

income_array_kb3 = np.array([
    tinh_total_income(loan_amounts_kb3[i], int_rates_kb3[i], term_monthses_kb3[i])
    for i in range(len(loan_amounts_kb3))
])

expected_loss_array_kb3   = PD_values_kb3 * loan_amounts_kb3 * LGD_BASE
result_df_kb3['E_profit'] = (1 - PD_values_kb3) * income_array_kb3 - expected_loss_array_kb3

threshold_grid = np.arange(0.05, 0.95, 0.01)
results_kb3 = []

for thr in threshold_grid:
    approved = result_df_kb3[result_df_kb3['PD'] <= thr]
    if len(approved) == 0:
        continue
    results_kb3.append({
        'threshold'    : thr,
        'n_approved'   : len(approved),
        'approval_rate': len(approved) / len(result_df_kb3) * 100,
        'total_profit' : approved['E_profit'].sum(),
        'mean_profit'  : approved['E_profit'].mean(),
        'total_loan'   : approved['loan_amnt'].sum(),
        'avg_PD'       : approved['PD'].mean(),
    })

df_kb3 = pd.DataFrame(results_kb3)

# Tối đa profit_ratio = total_profit / total_loan
df_kb3['profit_ratio'] = df_kb3['total_profit'] / df_kb3['total_loan']
idx_opt_kb3    = df_kb3['profit_ratio'].idxmax()
opt_thr_kb3    = df_kb3.loc[idx_opt_kb3, 'threshold']
opt_profit_kb3 = df_kb3.loc[idx_opt_kb3, 'total_profit']
opt_apr_kb3    = df_kb3.loc[idx_opt_kb3, 'approval_rate']
opt_ratio_kb3  = df_kb3.loc[idx_opt_kb3, 'profit_ratio']

print("\n=== KẾT QUẢ KB3 ===")
print(f"Threshold tối ưu : PD ≤ {opt_thr_kb3:.2f}")
print(f"Approval Rate    : {opt_apr_kb3:.1f}%")
print(f"Tổng E[Profit]   : ${opt_profit_kb3:,.0f}")
print(f"Profit/Loan ratio: {opt_ratio_kb3*100:.2f}%")
print(f"Số khoản duyệt   : {df_kb3.loc[idx_opt_kb3, 'n_approved']:,.0f}")

# Trực quan hoá
fig, axes = plt.subplots(1, 3, figsize=(18, 5))
fig.suptitle('KB3 — Portfolio Approval Policy: Tối ưu PD Threshold',
             fontsize=13, fontweight='bold')

# Biểu đồ 1: Biến thiên Tỷ suất lợi nhuận theo Ngưỡng cắt PD
ax = axes[0]
ax.plot(df_kb3['threshold'], df_kb3['profit_ratio'] * 100, 'b-', linewidth=2)
ax.axvline(opt_thr_kb3, color='red', linestyle='--',
           label=f'Optimal = {opt_thr_kb3:.2f}\n(Ratio={opt_ratio_kb3*100:.2f}%)')
ax.set_xlabel('PD Threshold'); ax.set_ylabel('Profit / Loan (%)')
ax.set_title('Profit/Loan Ratio theo Threshold\n(Metric tối ưu chính)')
ax.legend(); ax.grid(True, alpha=0.3)

# Biểu đồ 2: Tương quan giữa Tổng lợi nhuận danh mục và Chính sách phê duyệt.
ax2 = axes[1]
ax2.plot(df_kb3['threshold'], df_kb3['total_profit'] / 1e6, 'g-', linewidth=2)
ax2.axvline(opt_thr_kb3, color='red', linestyle='--',
            label=f'Optimal = {opt_thr_kb3:.2f}')
ax2.axhline(0, color='gray', linestyle=':')
ax2.fill_between(df_kb3['threshold'], df_kb3['total_profit'] / 1e6, 0,
                 where=df_kb3['total_profit'] > 0, alpha=0.1, color='green', label='Có lãi')
ax2.fill_between(df_kb3['threshold'], df_kb3['total_profit'] / 1e6, 0,
                 where=df_kb3['total_profit'] <= 0, alpha=0.1, color='red', label='Lỗ')
ax2.set_xlabel('PD Threshold'); ax2.set_ylabel('Total E[Profit] ($M)')
ax2.set_title('Tổng Lợi nhuận theo Threshold\n(Tham khảo)')
ax2.legend(); ax2.grid(True, alpha=0.3)

# Biểu đồ 3: Đánh đổi giữa Quy mô danh mục (Approval Rate) và Chất lượng rủi ro (Avg PD)
ax3 = axes[2]
# Vẽ Approval Rate lên trục chính (trái)
ax3.plot(df_kb3['threshold'], df_kb3['approval_rate'], color='orange', linewidth=2, label='Approval Rate (%)')
ax3.set_xlabel('PD Threshold')
ax3.set_ylabel('Approval Rate (%)', color='orange')
ax3.tick_params(axis='y', labelcolor='orange')

# Tạo trục phụ (phải) để vẽ Avg PD của danh mục được duyệt
ax3_twin = ax3.twinx()
ax3_twin.plot(df_kb3['threshold'], df_kb3['avg_PD'] * 100, color='darkblue', linestyle='--', linewidth=2, label='Avg PD (%)')
ax3_twin.set_ylabel('Average PD of Portfolio (%)', color='darkblue')
ax3_twin.tick_params(axis='y', labelcolor='darkblue')

# Thêm đường thẳng đánh dấu ngưỡng tối ưu
ax3.axvline(opt_thr_kb3, color='red', linestyle='--', label=f'Optimal = {opt_thr_kb3:.2f}')

ax3.set_title('Quy mô phê duyệt vs. Rủi ro trung bình\n(Đánh đổi số lượng & chất lượng)')
ax3.grid(True, alpha=0.3)
# Gom legend từ cả 2 trục
lines, labels = ax3.get_legend_handles_labels()
lines2, labels2 = ax3_twin.get_legend_handles_labels()
ax3.legend(lines + lines2, labels + labels2, loc='upper left', fontsize='small')

