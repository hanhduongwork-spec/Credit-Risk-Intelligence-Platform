"""## 2.4 Feature Engineering"""

def feature_engineering_pro(df):
    df = df.copy()

    # --- NHÓM 1: BIẾN GỐC CẦN XỬ LÝ ---
    if 'term' in df.columns:
        df['term_months'] = pd.to_numeric(df['term'].astype(str).str.extract(r'(\d+)')[0], errors='coerce')

    # --- NHÓM 2: CÁC BIẾN MỚI ---

    # 1. Khả năng trả nợ thực tế
    # Tỉ lệ số tiền vay trên tổng hạn mức sử dụng thực tế
    if {'loan_amnt', 'revol_util'}.issubset(df.columns):
        df['loan_to_revol_ratio'] = df['loan_amnt'] / (df['revol_util'] + 1)

    # 2. Thâm niên của hồ sơ tín dụng
    if 'earliest_cr_line' in df.columns:
        df['earliest_cr_line'] = pd.to_datetime(df['earliest_cr_line'], errors='coerce')
        df['credit_age_years'] = 2026 - df['earliest_cr_line'].dt.year

    # 3. Mức độ nợ nần tích lũy
    if {'pub_rec', 'pub_rec_bankruptcies'}.issubset(df.columns):
        df['total_bad_records'] = df['pub_rec'] + df['pub_rec_bankruptcies']

    # --- NHÓM 3: DROP ---
    to_drop = [
        # Bỏ biến gốc đã có bản CBRT (Tương quan 0.98 trong heatmap của bạn)
        'open_acc', 'total_acc', 'mort_acc', 'annual_inc', 'revol_bal',
        # Bỏ biến gây Leakage và biến rác
        'grade','issue_d', 'address', 'term', 'earliest_cr_line'
    ]

    df = df.drop(columns=[c for c in to_drop if c in df.columns], errors='ignore')

    return df

# Chạy lệnh
