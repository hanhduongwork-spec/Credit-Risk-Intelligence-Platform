# Tính toán các thành phần của đường cong ROC: False Positive Rate và True Positive Rate
fpr, tpr, thresholds = roc_curve(y_test, y_pred_proba)

# Tính toán chỉ số KS (Kolmogorov-Smirnov) - Khoảng cách lớn nhất giữa TPR và FPR
ks_stat = max(tpr - fpr)

# Tìm vị trí mà tại đó khoảng cách TPR - FPR là lớn nhất
optimal_idx = np.argmax(tpr - fpr)

# Xác định ngưỡng tối ưu tại vị trí đó thay vì dùng mức 0.5 mặc định
optimal_threshold = thresholds[optimal_idx]

# Chuyển đổi xác suất thành nhãn 0 hoặc 1 dựa trên ngưỡng tối ưu vừa tìm được
y_pred = (y_pred_proba >= optimal_threshold).astype(int)

print(f"AUC-ROC     : {roc_auc_score(y_test, y_pred_proba):.4f}")
print(f"KS Statistic: {ks_stat:.4f}")
print(f"Gini        : {2 * roc_auc_score(y_test, y_pred_proba) - 1:.4f}")
print(f"Threshold   : {optimal_threshold:.4f}")
print("\nClassification Report:")
print(classification_report(y_test, y_pred))

