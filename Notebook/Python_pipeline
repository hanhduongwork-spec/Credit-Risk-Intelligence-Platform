"""# 6. SIMULATION

## 6.1 Monte Carlo Simulation for Loan Portfolio Profit
"""

# Hàm tính lợi nhuận

LGD_BASE        = 0.70
ORIGINATION_FEE = 0.03

def tinh_total_income(loan_amnt, int_rate, term_months, fee_rate=ORIGINATION_FEE):
    r = int_rate / 100 / 12
    n = term_months
    if r == 0:
        monthly_pmt = loan_amnt / n
    else:
        monthly_pmt = loan_amnt * (r * (1 + r)**n) / ((1 + r)**n - 1)
    interest_income = monthly_pmt * n - loan_amnt
    origination_fee = loan_amnt * fee_rate
    return interest_income + origination_fee


def monte_carlo_profit(PD, loan_amnt, int_rate, term_months, lgd=LGD_BASE, N=10_000):
    income   = tinh_total_income(loan_amnt, int_rate, term_months)
    loss     = loan_amnt * lgd
    defaults = np.random.binomial(1, PD, size=N)
    profits  = np.where(defaults == 1, -loss, income)
    return {
        'mean_profit': profits.mean(),
        'std_profit':  profits.std(),
        'var_95':      np.percentile(profits, 5),
        'prob_profit': (profits > 0).mean()
    }

