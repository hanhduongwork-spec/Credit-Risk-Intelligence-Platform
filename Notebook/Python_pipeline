axes[1].set_ylabel('Allocated Budget ($M)')
axes[1].set_title('Phân bổ ngân sách tối ưu')
axes[1].tick_params(axis='x', rotation=90)
axes[1].grid(axis='y', alpha=0.3)

# Biểu đồ 3: Rủi ro và Lợi nhuận (Risk vs. Return)
ax3 = axes[2]
scatter = ax3.scatter(eligible['avg_PD'] * 100, eligible['profit_ratio'] * 100,
